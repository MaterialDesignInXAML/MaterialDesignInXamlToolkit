<UserControl x:Class="MaterialDesignDemo.Shared.Examples.Alerts.AlertCloseExamples"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML">
  <materialDesign:Card Padding="16">
    <StackPanel>
      <TextBlock Margin="0,0,0,8"
                 Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                 Text="Closable alerts" />
      <WrapPanel>
        <WrapPanel.Resources>
          <Style TargetType="smtx:XamlDisplay" BasedOn="{StaticResource {x:Type smtx:XamlDisplay}}">
            <Setter Property="Margin" Value="0,0,16,8" />
          </Style>
        </WrapPanel.Resources>
        <smtx:XamlDisplay UniqueKey="AlertExamples_CloseInfo">
          <materialDesign:Alert x:Name="InfoAlert"
                                CloseClick="Alert_OnCloseClick"
                                Content="Click the close icon to dismiss me"
                                Severity="Info"
                                ShowCloseButton="True" />
        </smtx:XamlDisplay>
        <smtx:XamlDisplay UniqueKey="AlertExamples_CloseWarning">
          <materialDesign:Alert x:Name="WarningAlert"
                                Title="Warning"
                                CloseClick="Alert_OnCloseClick"
                                Content="This alert can be dismissed as well."
                                Severity="Warning"
                                ShowCloseButton="True" />
        </smtx:XamlDisplay>
      </WrapPanel>
      <Button HorizontalAlignment="Left"
              Click="Reset_OnClick"
              Content="Reset" />
    </StackPanel>
  </materialDesign:Card>
</UserControl>
