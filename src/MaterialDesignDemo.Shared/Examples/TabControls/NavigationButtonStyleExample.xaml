<UserControl x:Class="MaterialDesignDemo.Shared.Examples.TabControls.NavigationButtonStyleExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaterialDesignDemo.Shared.Examples.TabControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
  <materialDesign:Card Padding="16">
    <StackPanel>
      <TextBlock Margin="0,0,0,8"
                 Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                 Text="Custom button style" />

      <TextBlock Margin="0,0,0,16"
                 Text="Use &quot;materialDesign:TabAssist.NavigationButtonStyle&quot; for a custom button style."
                 TextWrapping="Wrap" />

      <smtx:XamlDisplay HorizontalAlignment="Left" UniqueKey="TabControls_NavigationButtonStyleExample_1">
        <Border Width="600"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                BorderThickness="1">
          <TabControl materialDesign:TabAssist.HeaderBehavior="Scrolling"
                      materialDesign:TabAssist.NavigationPanelBehavior="Scroll"
                      materialDesign:TabAssist.UseNavigationPanel="True"
                      ItemsSource="{Binding LongList}"
                      Style="{StaticResource MaterialDesignTabControl}">
            <materialDesign:TabAssist.NavigationButtonStyle>
              <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Width" Value="24" />
              </Style>
            </materialDesign:TabAssist.NavigationButtonStyle>
            <TabControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding ., StringFormat=Header {0}}" />
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate>
                <TextBlock Margin="10"
                           FontSize="18"
                           Text="{Binding ., StringFormat=Content {0}}" />
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Border>
      </smtx:XamlDisplay>

    </StackPanel>
  </materialDesign:Card>
</UserControl>
