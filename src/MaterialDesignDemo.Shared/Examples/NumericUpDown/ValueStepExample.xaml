<UserControl x:Class="MaterialDesignDemo.Shared.Examples.NumericUpDown.ValueStepExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaterialDesignDemo.Shared.Examples.NumericUpDown"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
  <smtx:XamlDisplay UniqueKey="NumericUpDown_ValueStepExample">
    <materialDesign:Card Padding="16">
      <StackPanel>
        <TextBlock Margin="0,0,0,8"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Text="Value step" />

        <TextBlock Margin="0,0,0,16"
                   Text="Use the ValueStep property to set the amount the control changes for each increment/decrement."
                   TextWrapping="Wrap" />

        <WrapPanel Margin="0,0,0,8">
          <StackPanel Margin="8">
            <TextBlock Text="Default (1)" />
            <materialDesign:NumericUpDown Width="120" />
          </StackPanel>

          <StackPanel Margin="8">
            <TextBlock Text="ValueStep 5" />
            <materialDesign:NumericUpDown Width="120" ValueStep="5" />
          </StackPanel>

          <StackPanel Margin="8">
            <TextBlock Text="ValueStep 0.5" />
            <materialDesign:DecimalUpDown Width="120"
                                          ValueStep="0.5"
                                          Value="2.5" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </materialDesign:Card>
  </smtx:XamlDisplay>
</UserControl>
